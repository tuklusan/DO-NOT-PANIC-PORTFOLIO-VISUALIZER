    <ProjectReference Include="..\PortfolioSaver.Shared\PortfolioSaver.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\PortfolioSaver.Shared\Assets\Branding\dnppv-icon-rev-3.ico" Link="Assets\Branding\dnppv-icon-rev-3.ico" />
