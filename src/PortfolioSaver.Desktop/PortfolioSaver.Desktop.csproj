  </ItemGroup>
  <ItemGroup>
    <Content Include="..\PortfolioSaver.Screensaver\Assets\ExchangeBackgrounds\new-york-stock-exchange.jpg" Link="Assets\ExchangeBackgrounds\new-york-stock-exchange.jpg" CopyToOutputDirectory="PreserveNewest" />
