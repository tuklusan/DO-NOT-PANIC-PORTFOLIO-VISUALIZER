<Window x:Class="PortfolioSaver.Desktop.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About DO NOT PANIC PORTFOLIO VISUALIZER"
        Width="720"
        Height="560"
        MinWidth="640"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#0F1418">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                CornerRadius="14"
                BorderBrush="#284960"
                BorderThickness="1"
                Background="#131C23"
                Padding="12"
                Margin="0,0,0,18">
            <Image Source="/Assets/Branding/dnppv-icon-rev-3-splash.png"
                   Stretch="Uniform"
                   Height="240" />
        </Border>

        <Border Grid.Row="1"
                CornerRadius="12"
                Background="#171F26"
                BorderBrush="#233948"
                BorderThickness="1"
                Padding="18">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="DO NOT PANIC PORTFOLIO VISUALIZER"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding VersionText}"
                               Foreground="#A7C4DB"
                               FontSize="14"
                               Margin="0,0,0,16" />
                    <TextBlock Text="{Binding PublisherText}"
                               Foreground="#E5EDF4"
                               FontSize="15"
                               Margin="0,0,0,6" />
                    <TextBlock Text="{Binding AuthorText}"
                               Foreground="#E5EDF4"
                               FontSize="15"
                               Margin="0,0,0,6" />
                    <TextBlock Text="{Binding LicenseText}"
                               Foreground="#E5EDF4"
                               FontSize="15"
                               Margin="0,0,0,16" />
                    <TextBlock Text="DO NOT PANIC PORTFOLIO VISUALIZER is a decorative desktop market visualizer with animated ticker tapes, macro and world-market ribbons, graph cards, finance-news flavor text, and rotating exchange/city backgrounds. It is for ambient information and entertainment only: it absolutely must not be used as a financial planning, trading, alerting, advice, portfolio-monitoring, or decision-support tool."
                               Foreground="#C9D8E4"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Margin="0,0,0,18" />
                    <TextBlock Text="License Text"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <Border Background="#10171D"
                            BorderBrush="#284960"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <TextBlock Text="{Binding FullLicenseText}"
                                   Foreground="#C9D8E4"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="2"
                Content="OK"
                Width="110"
                Padding="16,7"
                Margin="0,18,0,0"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsCancel="True"
                Click="OnOkClick" />
    </Grid>
</Window>
