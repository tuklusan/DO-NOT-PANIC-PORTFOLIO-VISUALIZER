<Window x:Class="PortfolioSaver.Desktop.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About DO NOT PANIC PORTFOLIO VISUALIZER"
        Icon="/PortfolioSaver.Shared;component/Assets/Branding/dnppv-icon-rev-3.png"
        Width="720"
        Height="560"
        MinWidth="640"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#0F1418">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                CornerRadius="14"
                BorderBrush="#284960"
                BorderThickness="1"
                Background="#131C23"
                Padding="12"
                Margin="0,0,0,18">
            <Image Source="/PortfolioSaver.Shared;component/Assets/Branding/dnppv-icon-rev-3-splash.png"
                   Stretch="Uniform"
                   Height="240" />
        </Border>

        <Border Grid.Row="1"
                CornerRadius="12"
                Background="#171F26"
                BorderBrush="#233948"
                BorderThickness="1"
                Padding="18">
            <StackPanel>
                <TextBlock Text="DO NOT PANIC PORTFOLIO VISUALIZER"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           Margin="0,0,0,8" />
                <TextBlock Text="{Binding VersionText}"
                           Foreground="#A7C4DB"
                           FontSize="14"
                           Margin="0,0,0,16" />
                <TextBlock Text="{Binding PublisherText}"
                           Foreground="#E5EDF4"
                           FontSize="15"
                           Margin="0,0,0,6" />
                <TextBlock Text="{Binding AuthorText}"
                           Foreground="#E5EDF4"
                           FontSize="15"
                           Margin="0,0,0,6" />
                <TextBlock Text="{Binding LicenseText}"
                           Foreground="#E5EDF4"
                           FontSize="15"
                           Margin="0,0,0,16" />
                <TextBlock Text="BETA-6 desktop baseline. This build combines the top-level market ribbon, world markets, progressive ticker tapes, teleprinter-style finance news, and exchange-photo backgrounds under the DO NOT PANIC identity."
                           Foreground="#C9D8E4"
                           TextWrapping="Wrap"
                           FontSize="14"
                           Margin="0,0,0,10" />
                <TextBlock Text="The revision-3 brand assets are now the shared icon and splash sources for runtime surfaces so the desktop shell, config app, legacy screensaver host, and installer all present one coherent product identity."
                           Foreground="#AFC3D2"
                           TextWrapping="Wrap"
                           FontSize="13" />
            </StackPanel>
        </Border>

        <Button Grid.Row="2"
                Content="OK"
                Width="110"
                Padding="16,7"
                Margin="0,18,0,0"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsCancel="True"
                Click="OnOkClick" />
    </Grid>
</Window>
