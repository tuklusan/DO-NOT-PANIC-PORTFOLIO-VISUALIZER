<Window x:Class="PortfolioSaver.Desktop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:scene="clr-namespace:PortfolioSaver.Screensaver.Controls;assembly=PortfolioSaver.Presentation"
        xmlns:vm="clr-namespace:PortfolioSaver.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="DO NOT PANIC PORTFOLIO VISUALIZER"
        Width="1400"
        Height="900"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnWindowKeyDown">
    <Window.DataContext>
        <vm:DesktopShellViewModel />
    </Window.DataContext>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Full Screen" InputGestureText="F11" Click="OnFullScreenClick" />
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Header="_Settings" Click="OnSettingsClick" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <scene:ScreensaverSceneControl />
    </DockPanel>
</Window>
