<Window x:Class="PortfolioSaver.Desktop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:scene="clr-namespace:PortfolioSaver.Presentation.Controls;assembly=PortfolioSaver.Presentation"
        xmlns:vm="clr-namespace:PortfolioSaver.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="DO NOT PANIC PORTFOLIO VISUALIZER"
        Width="1180"
        Height="720"
        MinWidth="1180"
        MinHeight="720"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnWindowKeyDown"
        PreviewMouseLeftButtonDown="OnWindowPreviewMouseLeftButtonDown"
        PreviewMouseDoubleClick="OnWindowPreviewMouseDoubleClick"
        SizeChanged="OnWindowSizeChanged"
        LocationChanged="OnWindowLocationChanged"
        StateChanged="OnWindowStateChanged">
    <Window.DataContext>
        <vm:DesktopShellViewModel />
    </Window.DataContext>
    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="FullScreenMenuItem"
                          Header="_Full Screen"
                          InputGestureText="F11"
                          AutomationProperties.AutomationId="ViewFullScreenMenuItem"
                          Click="OnFullScreenClick" />
            </MenuItem>
            <MenuItem x:Name="OptionsMenuItem"
                      Header="_Options"
                      AutomationProperties.AutomationId="OptionsMenuRoot">
                <MenuItem x:Name="SettingsMenuItem"
                          Header="_Settings"
                          AutomationProperties.AutomationId="OptionsSettingsMenuItem"
                          Click="OnSettingsClick" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <scene:VisualizerSceneControl x:Name="SceneHost" />
    </DockPanel>
</Window>
