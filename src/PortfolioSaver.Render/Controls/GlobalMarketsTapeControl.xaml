<UserControl x:Class="PortfolioSaver.Render.Controls.GlobalMarketsTapeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="72"
             d:DesignWidth="1200">
    <Border Background="#B805090D"
            BorderBrush="#33476778"
            BorderThickness="1"
            CornerRadius="7"
            Margin="12,0,12,8"
            Padding="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#FF162A3A"
                    BorderBrush="#445C90AA"
                    BorderThickness="0,0,1,0"
                    Padding="11,8"
                    CornerRadius="7,0,0,7">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               Foreground="#FFEAF7FF"
                               FontFamily="Bahnschrift SemiCondensed"
                               FontSize="12"
                               FontWeight="Bold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    x:Name="PinnedCardHost"
                    Margin="8,0,10,0"
                    VerticalAlignment="Center"
                    Background="Transparent" />

            <Grid Grid.Column="2"
                  x:Name="ViewportHost"
                  ClipToBounds="True"
                  Height="68"
                  Margin="16,0,28,0"
                  VerticalAlignment="Center">
                <Grid.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0.00" />
                        <GradientStop Color="#FFFFFFFF" Offset="0.22" />
                        <GradientStop Color="#FFFFFFFF" Offset="0.90" />
                        <GradientStop Color="#00FFFFFF" Offset="1.00" />
                    </LinearGradientBrush>
                </Grid.OpacityMask>
                <Canvas x:Name="TrackPanel" />
                <Rectangle x:Name="LeftEdgeShroud"
                           Width="118"
                           HorizontalAlignment="Left"
                           IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#DA05090D" Offset="0.00" />
                            <GradientStop Color="#DA05090D" Offset="0.52" />
                            <GradientStop Color="#0005090D" Offset="1.00" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle x:Name="RightEdgeShroud"
                           Width="36"
                           HorizontalAlignment="Right"
                           IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0005090D" Offset="0.00" />
                            <GradientStop Color="#DA05090D" Offset="0.48" />
                            <GradientStop Color="#DA05090D" Offset="1.00" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
        </Grid>
    </Border>
</UserControl>
