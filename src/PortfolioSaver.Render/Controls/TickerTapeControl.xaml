<UserControl x:Class="PortfolioSaver.Render.Controls.TickerTapeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="80" d:DesignWidth="1200">
    <Border Background="#EE050505"
            BorderBrush="#332E3A47"
            BorderThickness="1"
            CornerRadius="7"
            Padding="9,4"
            Margin="8,3"
            VerticalAlignment="Center">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#FF121922"
                    BorderBrush="#5546637A"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="7,2"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           Foreground="#FF9AB5C8"
                           FontFamily="Consolas"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextOptions.TextFormattingMode="Display" />
            </Border>

            <Grid x:Name="ViewportHost"
                  Grid.Column="1"
                  Margin="4,0,4,0"
                  ClipToBounds="True"
                  Height="28"
                  VerticalAlignment="Center">
                <Canvas x:Name="TrackPanel" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
