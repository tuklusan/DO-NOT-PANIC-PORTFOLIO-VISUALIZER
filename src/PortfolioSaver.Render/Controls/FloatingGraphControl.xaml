<UserControl x:Class="PortfolioSaver.Render.Controls.FloatingGraphControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <Border x:Name="RootBorder"
            CornerRadius="10"
            Padding="7"
            Margin="4"
            Width="{Binding Width}"
            Height="{Binding Height}"
            Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibility}}"
            Background="{Binding CardBackground}"
            BorderBrush="{Binding CardBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Symbol}"
                               Foreground="#F5FAFF"
                               FontFamily="Consolas"
                               FontWeight="Bold"
                               FontSize="11" />
                    <TextBlock Text="{Binding OverlayText}"
                               Foreground="#A9C0D4"
                               FontFamily="Bahnschrift SemiCondensed"
                               FontWeight="SemiBold"
                               FontSize="8"
                               Margin="7,1,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <TextBlock Text="{Binding LastText}"
                               Foreground="#F5FAFF"
                               FontFamily="Consolas"
                               FontWeight="SemiBold"
                               FontSize="10" />
                    <TextBlock Text="{Binding ChangeText}"
                               Foreground="{Binding ChangeForeground}"
                               FontFamily="Consolas"
                               FontWeight="Bold"
                               FontSize="9"
                               Margin="8,1,0,0" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Margin="0,0,6,1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding MaxScaleText}" Foreground="#90B0C9" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Right" />
                    <TextBlock Grid.Row="1" Text="{Binding MidScaleText}" Foreground="#7E9AB0" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Text="{Binding MinScaleText}" Foreground="#90B0C9" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Right" />
                </Grid>

                <Grid Grid.Column="1" Width="{Binding PlotWidth}" Height="{Binding PlotHeight}" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Rectangle Height="1" Fill="#37AFC6D8" VerticalAlignment="Top" />
                    <Rectangle Width="1" Fill="#1EAFC6D8" HorizontalAlignment="Left" />
                    <Rectangle Width="1" Fill="#1EAFC6D8" HorizontalAlignment="Center" />
                    <Rectangle Width="1" Fill="#1EAFC6D8" HorizontalAlignment="Right" />
                    <Rectangle Height="1" Fill="#2AAFC6D8" VerticalAlignment="Center" />
                    <Rectangle Height="1" Fill="#37AFC6D8" VerticalAlignment="Bottom" />

                    <ItemsControl ItemsSource="{Binding GreenSegments}" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Polyline Points="{Binding}" Stroke="#66D672" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" SnapsToDevicePixels="True" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding RedSegments}" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Polyline Points="{Binding}" Stroke="#F06A6A" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" SnapsToDevicePixels="True" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Polyline Points="{Binding LatestSegmentPoints}"
                              Stroke="{Binding LatestSegmentBrush}"
                              StrokeThickness="3"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              SnapsToDevicePixels="True"
                              IsHitTestVisible="False" />

                    <Grid Grid.Row="1" Margin="2,3,12,0" ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding LeftTimeScaleText}" Foreground="#93A9BD" FontFamily="Consolas" FontSize="7" Margin="0,0,6,0" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="1" Text="{Binding MiddleTimeScaleText}" Foreground="#93A9BD" FontFamily="Consolas" FontSize="7" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding RightTimeScaleText}" Foreground="#93A9BD" FontFamily="Consolas" FontSize="7" Margin="6,0,0,0" MinWidth="24" TextAlignment="Right" HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
