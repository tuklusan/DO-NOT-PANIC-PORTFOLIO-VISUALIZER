<UserControl x:Class="PortfolioSaver.Render.Controls.NewsFlasherControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="54"
             d:DesignWidth="1200">
    <Border Background="#F1060606"
            BorderBrush="#88272727"
            BorderThickness="1"
            CornerRadius="8"
            Margin="12,0,12,12"
            Padding="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#FFD71920"
                    Padding="14,8"
                    CornerRadius="8,0,0,8">
                <TextBlock Text="{Binding Title}"
                           Foreground="White"
                           FontFamily="Bahnschrift SemiCondensed"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
            </Border>

            <Grid Grid.Column="1"
                  x:Name="ViewportHost"
                  ClipToBounds="True"
                  Height="44"
                  Margin="12,0,10,0"
                  VerticalAlignment="Center">
                <Canvas x:Name="TrackPanel">
                    <TextBlock x:Name="ActiveHeadlineBlock"
                               TextTrimming="None"
                               TextWrapping="Wrap"
                               Width="{Binding ElementName=ViewportHost, Path=ActualWidth}"
                               MaxHeight="38"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="19"
                               FontFamily="Courier New"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="WhiteSmoke"
                               VerticalAlignment="Center" />
                </Canvas>
            </Grid>
        </Grid>
    </Border>
</UserControl>
