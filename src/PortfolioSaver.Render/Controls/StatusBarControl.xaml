<UserControl x:Class="PortfolioSaver.Render.Controls.StatusBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             d:DesignHeight="82" d:DesignWidth="1200">
    <UserControl.Resources>
        <FontFamily x:Key="StableClockFont">Cascadia Mono,Consolas,Lucida Console</FontFamily>
    </UserControl.Resources>
    <Border Background="#55000000" Padding="10" MinHeight="68" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding MarketStatusText}"
                           Foreground="White"
                           Margin="0,0,10,0"
                           MaxWidth="280"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />

                <ItemsControl Grid.Column="1"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding MacroMeters}"
                              ClipToBounds="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#40131A23"
                                    BorderBrush="#5F6C7A8A"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="6,4"
                                    Margin="0,0,8,0"
                                    MinWidth="102">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="24" Height="24" Margin="0,0,6,0">
                                        <Path Data="{Binding TrackPath}"
                                              Stroke="#44596C82"
                                              StrokeThickness="2.1"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                        <Path Data="{Binding ArcPath}"
                                              Stroke="{Binding AccentBrush}"
                                              StrokeThickness="2.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                        <Path Data="{Binding NeedlePath}"
                                              Stroke="#F6FBFF"
                                              StrokeThickness="1.2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                        <Ellipse Width="3.2" Height="3.2" Fill="#E6F2FF" Stroke="#5F6C7A8A" StrokeThickness="0.5" />
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Foreground="#C8D6E5" FontSize="10" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ValueText}" Foreground="White" FontFamily="{StaticResource StableClockFont}" FontSize="11" MinWidth="34" TextAlignment="Right" />
                                            <TextBlock Text="{Binding ChangeText}" Foreground="{Binding AccentBrush}" FontFamily="{StaticResource StableClockFont}" FontSize="11" Margin="5,0,0,0" MinWidth="26" TextAlignment="Right" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Column="2"
                        MinWidth="128"
                        Padding="7,4"
                        Background="#CC05090D"
                        BorderBrush="#334F7489"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="8,0,0,0"
                        ClipToBounds="True"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                    <StackPanel>
                        <TextBlock Text="{Binding ClockDateText}"
                                   Foreground="#D8E9F8"
                                   FontFamily="{StaticResource StableClockFont}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   TextAlignment="Right"
                                   TextTrimming="CharacterEllipsis"
                                   SnapsToDevicePixels="True" />
                        <TextBlock Text="{Binding ClockText}"
                                   Foreground="White"
                                   FontFamily="{StaticResource StableClockFont}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextAlignment="Right"
                                   TextTrimming="CharacterEllipsis"
                                   SnapsToDevicePixels="True" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0,6,0,0" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding UpdatedText}"
                           Foreground="#D2DFEB"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="196" />

                <Border Grid.Column="1" Background="Transparent" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
