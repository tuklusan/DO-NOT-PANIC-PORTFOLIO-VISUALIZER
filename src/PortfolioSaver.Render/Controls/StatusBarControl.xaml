<UserControl x:Class="PortfolioSaver.Render.Controls.StatusBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             d:DesignHeight="82" d:DesignWidth="1200">
    <UserControl.Resources>
        <FontFamily x:Key="StableClockFont">Cascadia Mono,Consolas,Lucida Console</FontFamily>
    </UserControl.Resources>
    <Border Background="#55000000" Padding="8,6" MinHeight="92" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        MaxWidth="248"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding MarketStatusText}"
                           Foreground="White"
                           FontFamily="{StaticResource StableClockFont}"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           LineStackingStrategy="BlockLineHeight"
                           LineHeight="15" />
                <StackPanel Orientation="Horizontal"
                            Margin="0,2,0,0"
                            MaxWidth="248">
                    <TextBlock Text="{Binding UpdatedPrefixText}"
                               Foreground="#D2DFEB"
                               FontFamily="{StaticResource StableClockFont}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding UpdatedTickerFieldText}"
                               Width="222"
                               Foreground="{Binding UpdatedTickerFieldForeground}"
                               FontFamily="{StaticResource StableClockFont}"
                               Margin="4,0,0,0"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Text="{Binding DataFreshnessText}"
                           AutomationProperties.AutomationId="RuntimeDataFreshnessText"
                           AutomationProperties.Name="{Binding DataFreshnessText}"
                           Foreground="{Binding DataFreshnessForeground}"
                           FontFamily="{StaticResource StableClockFont}"
                           FontSize="10"
                           Margin="0,2,0,0"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <ItemsControl Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding MacroMeters}"
                          ClipToBounds="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#40131A23"
                                BorderBrush="#5F6C7A8A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4,5"
                                Margin="0,0,4,0"
                                Width="96"
                                MinHeight="50">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="20" Height="20" Margin="0,0,4,0">
                                    <Path Data="{Binding TrackPath}"
                                          Stroke="#44596C82"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Path Data="{Binding ArcPath}"
                                          Stroke="{Binding AccentBrush}"
                                          StrokeThickness="2.3"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Path Data="{Binding NeedlePath}"
                                          Stroke="#F6FBFF"
                                          StrokeThickness="1.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Ellipse Width="3.2" Height="3.2" Fill="#E6F2FF" Stroke="#5F6C7A8A" StrokeThickness="0.5" />
                                </Grid>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="#C8D6E5"
                                               FontSize="8"
                                               FontWeight="SemiBold"
                                               TextAlignment="Left" />
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding ValueText}"
                                               Foreground="White"
                                               FontFamily="{StaticResource StableClockFont}"
                                               FontSize="10.5"
                                               TextAlignment="Left"
                                               Margin="0,1,0,0" />
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding ChangeText}"
                                               Foreground="{Binding AccentBrush}"
                                               FontFamily="{StaticResource StableClockFont}"
                                               FontSize="9.5"
                                               TextAlignment="Left" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Column="2"
                    MinWidth="102"
                    Padding="6,4"
                    Background="#CC05090D"
                    BorderBrush="#334F7489"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="4,0,0,0"
                    ClipToBounds="True"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right">
                <StackPanel>
                    <TextBlock Text="{Binding ClockDateText}"
                               Foreground="#D8E9F8"
                               FontFamily="{StaticResource StableClockFont}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               SnapsToDevicePixels="True" />
                    <TextBlock Text="{Binding ClockText}"
                               Foreground="White"
                               FontFamily="{StaticResource StableClockFont}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               SnapsToDevicePixels="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
