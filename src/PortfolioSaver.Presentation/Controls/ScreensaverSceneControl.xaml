<UserControl x:Class="PortfolioSaver.Screensaver.Controls.ScreensaverSceneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:PortfolioSaver.Render.Controls;assembly=PortfolioSaver.Render"
             xmlns:vm="clr-namespace:PortfolioSaver.Render.ViewModels;assembly=PortfolioSaver.Render"
             mc:Ignorable="d">
    <Grid Background="Transparent">
        <Grid IsHitTestVisible="False">
            <!-- Intentionally stretch user-supplied backgrounds to screen bounds; CR-160 prefers distortion over crop. -->
            <Image x:Name="BackgroundImageA"
                   Stretch="Fill"
                   Opacity="0.45"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                        <TranslateTransform X="0" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <Image x:Name="BackgroundImageB"
                   Stretch="Fill"
                   Opacity="0"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                        <TranslateTransform X="0" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Grid>
        <Rectangle x:Name="DimOverlay" Fill="#8C000000" />
        <TextBlock x:Name="VersionWatermark"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,12,8"
                   Foreground="#66D0D8E2"
                   FontSize="10"
                   FontFamily="Consolas"
                   Panel.ZIndex="90"
                   IsHitTestVisible="False" />
        <TextBlock x:Name="FooterAttributionWatermark"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="12,0,0,8"
                   Foreground="#66D0D8E2"
                   FontSize="10"
                   FontFamily="Consolas"
                   MaxWidth="1100"
                   TextWrapping="Wrap"
                   Panel.ZIndex="90"
                   IsHitTestVisible="False"
                   Text="&#169; Supratim Sanyal. SANYALnet Labs." />
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,8"
                   Foreground="#66D0D8E2"
                   FontSize="10"
                   FontFamily="Consolas"
                   Panel.ZIndex="90"
                   IsHitTestVisible="False"
                   Text="Delayed by minimum 15 minutes." />
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,10,0,0"
                Padding="26,6"
                Background="#AA05090D"
                BorderBrush="#6698D8FF"
                BorderThickness="1.2"
                CornerRadius="18"
                Panel.ZIndex="91"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="#3378C7FF"
                                  BlurRadius="14"
                                  ShadowDepth="0"
                                  Opacity="0.55" />
            </Border.Effect>
            <TextBlock Text="SANYALnet Labs DO NOT PANIC Portfolio Visualizer"
                       Foreground="#F4F9FFFF"
                       FontFamily="Bahnschrift SemiCondensed"
                       FontSize="19"
                       FontWeight="Bold"
                       TextOptions.TextFormattingMode="Display" />
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Canvas x:Name="FloatingOverlayCanvas"
                    Grid.RowSpan="3"
                    IsHitTestVisible="False">
                <Canvas x:Name="FloatingGraphCanvas"
                        Width="{Binding ElementName=FloatingOverlayCanvas, Path=ActualWidth}"
                        Height="{Binding ElementName=FloatingOverlayCanvas, Path=ActualHeight}"
                        Canvas.Left="0"
                        Canvas.Top="0"
                        IsHitTestVisible="False" />
                <ItemsControl x:Name="MarketSpriteItemsControl"
                              Width="{Binding ElementName=FloatingOverlayCanvas, Path=ActualWidth}"
                              Height="{Binding ElementName=FloatingOverlayCanvas, Path=ActualHeight}"
                              Canvas.Left="0"
                              Canvas.Top="0"
                              IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MarketSpriteViewModel}">
                            <TextBlock Text="{Binding SpriteText}"
                                       Foreground="{Binding Foreground}"
                                       TextOptions.TextFormattingMode="Display"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBag}" Value="False">
                                                <Setter Property="FontSize" Value="30" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding ScaleX}" ScaleY="1" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ContentControl x:Name="NetworkWaitingHost"
                                Width="340"
                                Height="110"
                                Visibility="Collapsed">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:NetworkWaitingViewModel}">
                            <Border Background="#B01B1B1B"
                                    BorderBrush="#66F5D061"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="18">
                                <StackPanel>
                                    <TextBlock Text="{Binding TitleText}"
                                               Foreground="#FFF3D37A"
                                               FontSize="22"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DetailText}"
                                               Foreground="#FFE8E8E8"
                                               Margin="0,10,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="14" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Canvas>

            <controls:StatusBarControl x:Name="StatusBarHost"
                                       Grid.Row="0"
                                       Margin="0,42,0,0" />

            <ItemsControl x:Name="TapeItemsControl"
                          Grid.Row="1"
                          Margin="0,188,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:TickerTapeControl />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel x:Name="BottomOverlayPanel"
                        Grid.Row="2"
                        Orientation="Vertical">
                <ContentControl x:Name="GlobalMarketsTapeHost"
                                Visibility="Collapsed">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:FloatingClockViewModel}">
                            <controls:GlobalMarketsTapeControl />
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>

                <ContentControl x:Name="NewsFlasherHost">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:NewsFlasherViewModel}">
                            <controls:NewsFlasherControl />
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
