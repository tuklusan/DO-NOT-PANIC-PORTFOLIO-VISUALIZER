<Window x:Class="PortfolioSaver.Config.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PortfolioSaver.Config.ViewModels"
        xmlns:infra="clr-namespace:PortfolioSaver.Config.Infrastructure"
        xmlns:enums="clr-namespace:PortfolioSaver.Core.Enums;assembly=PortfolioSaver.Core"
        mc:Ignorable="d"
        Title="DO NOT PANIC PORTFOLIO VISUALIZER Config - BETA-7"
        Width="940"
        Height="620"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#171717"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#222222" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDDDDD" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="HelpBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="#2C5878" />
            <Setter Property="BorderBrush" Value="#6FA9D6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HelpBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionNoteStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAB6C1" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="ConfigTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#9AAABD" />
            <Setter Property="Background" Value="#171717" />
            <Setter Property="BorderBrush" Value="#263746" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6,6,0,0"
                                Margin="0,0,4,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#202B35" />
                                <Setter Property="Foreground" Value="#DCEBFA" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#263746" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#7FB6E0" />
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,1,1,0" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#617182" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#263746" />
            <Setter Property="Foreground" Value="#F4FAFF" />
            <Setter Property="BorderBrush" Value="#526A7B" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="DarkDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#EAF3FA" />
            <Setter Property="BorderBrush" Value="#33434F" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style x:Key="DarkDataGridTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAF3FA" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DarkDataGridWrappedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DarkDataGridTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs"
                    Grid.Row="0"
                    Margin="12"
                    Background="#171717"
                    BorderBrush="#171717"
                    IsEnabled="{Binding IsConfigActive}"
                    ItemContainerStyle="{StaticResource ConfigTabItemStyle}">
            <TabItem Header="General">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Background="#171717">
                    <StackPanel Margin="16" Grid.IsSharedSizeScope="True">
                        <TextBlock Text="DO NOT PANIC PORTFOLIO VISUALIZER Settings"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20" />

                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Background" Foreground="White" FontSize="20" />
                                        <Border Style="{StaticResource HelpBadgeStyle}" ToolTip="Choose your own image folder, or leave this off to use the built-in background rotation.">
                                            <TextBlock Text="?" Style="{StaticResource HelpBadgeTextStyle}" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <CheckBox x:Name="UseCustomBackgroundFolderCheckBox"
                                          Content="Use my image folder"
                                          IsChecked="{Binding Settings.UseCustomBackgroundImageFolder}"
                                          Foreground="#DDDDDD"
                                          Margin="0,0,0,6" />
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="112" SharedSizeGroup="GeneralLabelCol" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Custom image folder:" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Grid.Column="1"
                                             MinWidth="128"
                                             IsReadOnly="True"
                                             Text="{Binding Settings.CustomBackgroundImageFolder, Mode=OneWay}" />
                                    <Button Grid.Column="2"
                                            Content="Choose..."
                                            Command="{Binding ChooseBackgroundFolderCommand}"
                                            IsEnabled="{Binding ElementName=UseCustomBackgroundFolderCheckBox, Path=IsChecked}"
                                            MinWidth="92"
                                            Margin="8,0,0,0"
                                            Padding="10,3" />
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="156" SharedSizeGroup="GeneralLabelCol" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="92" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Change interval:" Style="{StaticResource FieldLabelStyle}" />
                                    <Slider x:Name="BackgroundRefreshSlider" Grid.Column="1" Minimum="120" Maximum="14400" SmallChange="30" LargeChange="300" TickFrequency="30" IsSnapToTickEnabled="True" Value="{Binding Settings.BackgroundChangeSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2" Margin="12,0,0,0" Foreground="#F3D57F" VerticalAlignment="Center" Text="{Binding ElementName=BackgroundRefreshSlider, Path=Value, StringFormat={}{0:0}s}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Portfolio tapes" Foreground="White" FontSize="20" />
                                        <Border Style="{StaticResource HelpBadgeStyle}" ToolTip="Ticker names fill in during Validate when available.">
                                            <TextBlock Text="?" Style="{StaticResource HelpBadgeTextStyle}" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="Edit the ticker tapes the screensaver should display." Foreground="#DDDDDD" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <TextBlock Text="Leave a Name blank if you want Validate to fill it in when available." Style="{StaticResource SectionNoteStyle}" Margin="0,0,0,12" />

                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Portfolio tapes" Foreground="White" FontSize="18" VerticalAlignment="Center" />
                                    <Button Content="Add Tape" Command="{Binding AddGroupCommand}" Width="120" DockPanel.Dock="Right" />
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding Groups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#2A2A2A" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,10">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding TickerSlotsLabel}" Foreground="#9FB0C0" Margin="12,1,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <Button Content="Remove Tape" Command="{Binding RemoveGroupCommand}" Width="120" DockPanel.Dock="Right" />
                                                    </DockPanel>

                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="74" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Name:" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" />
                                                        <TextBox Grid.Column="1" MaxLength="16" MinWidth="92" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" />
                                                        <CheckBox Grid.Column="2" Content="Enabled" IsChecked="{Binding Enabled}" Foreground="#DDDDDD" VerticalAlignment="Center" />
                                                    </Grid>

                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="74" />
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Direction:" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" />
                                                        <ComboBox Grid.Column="1"
                                                                  SelectedValue="{Binding Direction, Mode=TwoWay}"
                                                                  SelectedValuePath="Tag"
                                                                  Margin="0,0,12,0">
                                                            <ComboBoxItem Content="Left" Tag="{x:Static enums:ScrollDirection.Left}" />
                                                            <ComboBoxItem Content="Right" Tag="{x:Static enums:ScrollDirection.Right}" />
                                                        </ComboBox>
                                                    </Grid>

                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="74" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="72" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Speed:" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" />
                                                        <Slider Grid.Column="1" Minimum="0.20" Maximum="0.65" TickFrequency="0.025" IsSnapToTickEnabled="True" Value="{Binding SpeedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock Grid.Column="2" Margin="12,0,0,0" Foreground="#F3D57F" VerticalAlignment="Center" Text="{Binding SpeedPresetLabel}" />
                                                        <TextBlock Grid.Column="3" Foreground="#9FB0C0" VerticalAlignment="Center" Text="{Binding SpeedValue, StringFormat=Slow / Normal / Fast ({0:0.000})}" />
                                                    </Grid>

                                                    <TextBlock Text="Tickers" Foreground="White" FontSize="15" Margin="0,4,0,4" />
                                                    <TextBlock Text="Edit the symbol only. Name fills in during Validate when available." Style="{StaticResource SectionNoteStyle}" Margin="0,0,0,8" />
                                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding Tickers}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="1.5*" MinWidth="92" />
                                                                            <ColumnDefinition Width="2.2*" MinWidth="132" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="60" />
                                                                            <ColumnDefinition Width="72" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding Symbol, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ticker symbol, fund symbol, index symbol, futures symbol, or other supported market symbol." />
                                                                        <TextBox Grid.Column="1"
                                                                                 Margin="0,0,8,0"
                                                                                 Text="{Binding DisplayName}"
                                                                                 IsReadOnly="True"
                                                                                 Background="#1A1A1A"
                                                                                 Foreground="#C8D6E3"
                                                                                 ToolTip="Filled automatically during Validate when available." />
                                                                        <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" Foreground="#DDDDDD" Margin="4,0,4,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="3"
                                                                                   Text="{Binding ValidationBadgeText}"
                                                                                   ToolTip="{Binding ValidationMessage}"
                                                                                   VerticalAlignment="Center"
                                                                                   HorizontalAlignment="Center"
                                                                                   FontWeight="SemiBold">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="#A8B3BF" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding ValidationState}" Value="{x:Static vm:SymbolValidationState.Checking}">
                                                                                            <Setter Property="Foreground" Value="#F3D57F" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding ValidationState}" Value="{x:Static vm:SymbolValidationState.Valid}">
                                                                                            <Setter Property="Foreground" Value="#68E081" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding ValidationState}" Value="{x:Static vm:SymbolValidationState.Invalid}">
                                                                                            <Setter Property="Foreground" Value="#FF7A7A" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <Button Grid.Column="4" Content="Remove" Command="{Binding RemoveCommand}" MinWidth="64" Margin="8,0,0,0" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>

                                                    <Button Content="Add Ticker" Command="{Binding AddTickerCommand}" Width="120" Margin="0,8,0,0" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Advanced">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="#171717">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Advanced News Settings" Foreground="White" FontSize="28" FontWeight="Bold" />
                                <Border Style="{StaticResource HelpBadgeStyle}" ToolTip="Optional AI summarization requires an API key. RSS mode uses the feed URL below.">
                                    <TextBlock Text="?" Style="{StaticResource HelpBadgeTextStyle}" />
                                </Border>
                            </StackPanel>
                        </DockPanel>
                        <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="News Scroller" Foreground="White" FontSize="20" />
                                        <Border Style="{StaticResource HelpBadgeStyle}" ToolTip="Choose summarized financial news or a plain RSS feed.">
                                            <TextBlock Text="?" Style="{StaticResource HelpBadgeTextStyle}" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <StackPanel Margin="0,4,0,8">
                                    <RadioButton Content="Summarized Financial News"
                                                 Foreground="#EAF3FA"
                                                 GroupName="NewsScrollerMode"
                                                 IsChecked="{Binding IsSummarizedFinancialNewsSelected, Mode=TwoWay}"
                                                 Margin="0,0,0,8" />
                                    <RadioButton Content="RSS Feed"
                                                 Foreground="#EAF3FA"
                                                 GroupName="NewsScrollerMode"
                                                 IsChecked="{Binding IsRssFeedSelected, Mode=TwoWay}" />
                                </StackPanel>

                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="156" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Writing style:" Style="{StaticResource FieldLabelStyle}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding IsSummarizedFinancialNewsSelected}">
                                        <RadioButton Content="Douglas Adams"
                                                     Foreground="#EAF3FA"
                                                     GroupName="DeepSeekWritingStyle"
                                                     IsChecked="{Binding IsDouglasAdamsStyleSelected, Mode=TwoWay}"
                                                     Margin="0,0,24,0" />
                                        <RadioButton Content="William Shakespeare"
                                                     Foreground="#EAF3FA"
                                                     GroupName="DeepSeekWritingStyle"
                                                     IsChecked="{Binding IsWilliamShakespeareStyleSelected, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="156" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="RSS feed URL:" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Grid.Column="1"
                                             MinWidth="128"
                                             IsEnabled="{Binding IsRssFeedSelected}"
                                             Text="{Binding Settings.NewsFeedUrl, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="156" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="92" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Headline refresh:" Style="{StaticResource FieldLabelStyle}" />
                                    <Slider x:Name="NewsRefreshSlider"
                                            Grid.Column="1"
                                            Minimum="5"
                                            Maximum="240"
                                            SmallChange="5"
                                            LargeChange="15"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding Settings.NewsRefreshMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2" Margin="12,0,0,0" Foreground="#F3D57F" VerticalAlignment="Center" Text="{Binding ElementName=NewsRefreshSlider, Path=Value, StringFormat={}{0:0}m}" />
                                </Grid>
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="156" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="AI API key:" Style="{StaticResource FieldLabelStyle}" />
                                    <PasswordBox Grid.Column="1"
                                                 MinWidth="128"
                                                 infra:BindablePasswordBox.BoundPassword="{Binding Settings.DeepSeekApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="156" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="AI endpoint URL:" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Grid.Column="1"
                                             MinWidth="128"
                                             IsEnabled="{Binding IsSummarizedFinancialNewsSelected}"
                                             Text="{Binding Settings.DeepSeekEndpointUrl, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="156" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="AI model ID:" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Grid.Column="1"
                                             MinWidth="128"
                                             IsEnabled="{Binding IsSummarizedFinancialNewsSelected}"
                                             Text="{Binding Settings.DeepSeekModelId, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <TextBlock Text="Summarized mode requires an API key. RSS mode uses the feed URL above." Style="{StaticResource SectionNoteStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="0"
                Margin="12"
                Background="#CC0F1115"
                CornerRadius="8"
                Visibility="{Binding ShowNetworkLockOverlay, Converter={StaticResource BoolToVisibilityConverter}}"
                Panel.ZIndex="200">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <TextBlock Text="Internet connection is required to edit and validate this configuration."
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap" />
                <TextBlock Text="Reconnect network and click Retry to continue."
                           Foreground="#CFD8E1"
                           FontSize="14"
                           TextAlignment="Center"
                           Margin="0,0,0,14"
                           TextWrapping="Wrap" />
                <Button Content="Retry"
                        Command="{Binding RetryNetworkCommand}"
                        Width="140"
                        HorizontalAlignment="Center"
                        Padding="14,6" />
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="#101010" Padding="14" MinHeight="66">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           AutomationProperties.AutomationId="ConfigStatusText"
                           Text="{Binding StatusMessage}"
                           Foreground="#CCCCCC"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,16,0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding VersionLabel}"
                           Foreground="#6B8195"
                           FontSize="10"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           Margin="0,0,16,0" />
                <Button Grid.Column="2"
                        x:Name="CancelButton"
                        AutomationProperties.AutomationId="ConfigCancelButton"
                        AutomationProperties.Name="Cancel"
                        Content="Cancel"
                        Visibility="{Binding ShowValidatedActionButtons, Converter={StaticResource BoolToVisibilityConverter}}"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        MinWidth="96"
                        Padding="14,6"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center" />
                <Button Grid.Column="3"
                        x:Name="OkButton"
                        AutomationProperties.AutomationId="ConfigOkButton"
                        AutomationProperties.Name="OK"
                        Content="OK"
                        Visibility="{Binding ShowValidatedActionButtons, Converter={StaticResource BoolToVisibilityConverter}}"
                        Command="{Binding OkCommand}"
                        IsDefault="True"
                        MinWidth="96"
                        Padding="14,6"
                        VerticalAlignment="Center" />
                <Button Grid.Column="3"
                        x:Name="PrimaryButton"
                        AutomationProperties.AutomationId="ConfigPrimaryButton"
                        AutomationProperties.Name="{Binding PrimaryButtonText}"
                        Content="{Binding PrimaryButtonText}"
                        Visibility="{Binding ShowValidateButton, Converter={StaticResource BoolToVisibilityConverter}}"
                        IsEnabled="{Binding IsValidationActionEnabled}"
                        Command="{Binding PrimaryCommand}"
                        IsDefault="True"
                        MinWidth="112"
                        Padding="14,6"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Border x:Name="StartupShield"
                Grid.RowSpan="2"
                Background="#F0121418"
                Panel.ZIndex="500"
                IsHitTestVisible="True">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420">
                <TextBlock Text="Preparing configuration..."
                           Foreground="#F4FAFF"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           Margin="0,0,0,8" />
                <TextBlock Text="Warming the General and Advanced tabs so the first visible frame is clean and readable."
                           Foreground="#BFD0DE"
                           FontSize="13"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
