<Window x:Class="PortfolioSaver.Config.Windows.DocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Document"
        Width="760"
        Height="560"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#171717"
        Foreground="#F4F4F4">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#222222"
                BorderBrush="#33485D72"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DocumentTextBlock"
                           TextWrapping="Wrap"
                           FontSize="14"
                           LineHeight="22" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="OpenLinkButton"
                    Content="Open Official Link"
                    Margin="0,0,10,0"
                    Padding="12,4"
                    Visibility="Collapsed"
                    Click="OpenLink_Click" />
            <Button Content="Close"
                    Width="100"
                    IsDefault="True"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
