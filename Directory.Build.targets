<Project>
  <Target Name="CopyPortfolioSaverThirdPartyFilesToBuildOutput"
          AfterTargets="Build"
          Condition="('$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe') And '$(_IsPublishing)' != 'true'">
    <ItemGroup>
      <PortfolioSaverDistributionRootFile Include="$(MSBuildThisFileDirectory)LICENSE"
                                          Condition="Exists('$(MSBuildThisFileDirectory)LICENSE')" />
      <PortfolioSaverDistributionRootFile Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md"
                                          Condition="Exists('$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md')" />
      <PortfolioSaverDistributionLicenseFile Include="$(MSBuildThisFileDirectory)THIRD-PARTY-LICENSES\**\*"
                                             Condition="Exists('$(MSBuildThisFileDirectory)THIRD-PARTY-LICENSES')" />
    </ItemGroup>

    <Copy SourceFiles="@(PortfolioSaverDistributionRootFile)"
          DestinationFiles="@(PortfolioSaverDistributionRootFile->'$(TargetDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PortfolioSaverDistributionLicenseFile)"
          DestinationFiles="@(PortfolioSaverDistributionLicenseFile->'$(TargetDir)THIRD-PARTY-LICENSES\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyPortfolioSaverThirdPartyFilesToPublishOutput"
          AfterTargets="Publish"
          Condition="('$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe') And '$(PublishDir)' != ''">
    <ItemGroup>
      <PortfolioSaverDistributionRootFile Include="$(MSBuildThisFileDirectory)LICENSE"
                                          Condition="Exists('$(MSBuildThisFileDirectory)LICENSE')" />
      <PortfolioSaverDistributionRootFile Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md"
                                          Condition="Exists('$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md')" />
      <PortfolioSaverDistributionLicenseFile Include="$(MSBuildThisFileDirectory)THIRD-PARTY-LICENSES\**\*"
                                             Condition="Exists('$(MSBuildThisFileDirectory)THIRD-PARTY-LICENSES')" />
    </ItemGroup>

    <Copy SourceFiles="@(PortfolioSaverDistributionRootFile)"
          DestinationFiles="@(PortfolioSaverDistributionRootFile->'$(PublishDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PortfolioSaverDistributionLicenseFile)"
          DestinationFiles="@(PortfolioSaverDistributionLicenseFile->'$(PublishDir)THIRD-PARTY-LICENSES\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
