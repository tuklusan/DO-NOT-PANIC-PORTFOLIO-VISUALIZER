<Project>
  <PropertyGroup>
    <PortfolioSaverVersion>0.9.0-beta7</PortfolioSaverVersion>
    <PortfolioSaverBaselineLabel>BETA-7</PortfolioSaverBaselineLabel>
    <Version Condition="'$(Version)' == ''">$(PortfolioSaverVersion)</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">0.9.0.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">0.9.0.0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(PortfolioSaverVersion) ($(PortfolioSaverBaselineLabel))</InformationalVersion>
    <Product Condition="'$(Product)' == ''">DO NOT PANIC PORTFOLIO VISUALIZER</Product>
    <Company Condition="'$(Company)' == ''">SANYALnet Labs</Company>
    <Authors Condition="'$(Authors)' == ''">Supratim Sanyal</Authors>
    <Copyright Condition="'$(Copyright)' == ''">Copyright (c) 2026 Supratim Sanyal of SANYALnet Labs. Proprietary rights reserved except as expressly licensed herein.</Copyright>
    <PackageLicenseFile Condition="'$(PackageLicenseFile)' == ''">LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)LICENSE')">
    <None Include="$(MSBuildThisFileDirectory)LICENSE"
          Link="LICENSE"
          Pack="true"
          PackagePath=""
          CopyToOutputDirectory="Never"
          CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md')">
    <!-- Package inclusion only. Directory.Build.targets defines executable output
         copy items separately with their own TargetPath metadata. -->
    <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md"
                            PackagePath="" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)THIRD-PARTY-LICENSES')">
    <!-- Package inclusion only. Directory.Build.targets defines executable output
         copy items separately with their own TargetPath metadata. -->
    <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)THIRD-PARTY-LICENSES\**\*"
                            PackagePath="THIRD-PARTY-LICENSES\%(RecursiveDir)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(PortfolioSaverInstallerBaseIntermediateRoot)' != ''">
    <BaseIntermediateOutputPath>$([MSBuild]::EnsureTrailingSlash('$(PortfolioSaverInstallerBaseIntermediateRoot)'))$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\**;$(MSBuildProjectDirectory)\bin\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PortfolioSaverInstallerBaseOutputRoot)' != ''">
    <BaseOutputPath>$([MSBuild]::EnsureTrailingSlash('$(PortfolioSaverInstallerBaseOutputRoot)'))$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
